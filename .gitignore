node_modules/
dist/
coverage/
*.tsbuildinfo
.ieos/
.DS_Store

# Platform qualification records are produced by CI, never by a laptop.
# The report cites them inline; a stale local copy would only invite confusion.
qualification/evidence/platforms/

# A stage report is committed only when CI generated it from BOTH platform
# records, under its dated name. The undated file is what `pnpm report:stage<N>`
# writes by default: it is made from one platform, so it can only ever say NOT
# PASSED for a reason that is about the machine that ran it rather than about
# the stage -- exactly the confusion the report exists to remove. This holds for
# every stage, not only Stage 0.
qualification/reports/stage-0?-report.md

# Per-platform SQLite evidence is produced by CI into its own file, never
# committed: the committed record is the two-candidate one, and the durable
# win32 result is the provenanced transcript beside it.
qualification/evidence/sqlite-qualification.win32.json

# The compiled knowledge index is a build artifact: `pnpm build:index` produces
# it from `knowledge/`, and committing it would create a second source of truth
# that could disagree with the tree it was built from.
knowledge.sqlite
knowledge.sqlite-wal
knowledge.sqlite-shm
