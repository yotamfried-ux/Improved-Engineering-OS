{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "type": "string",
      "enum": [
        "development",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "introduced_in": {
      "type": "string",
      "minLength": 1
    },
    "deprecated_in": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "migration_path": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "session.start",
            "session.end",
            "tool.call",
            "tool.result",
            "resolve.request",
            "resolve.response",
            "inspect.request",
            "expand.request",
            "observe.request",
            "test.run",
            "error"
          ]
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "installation_id": {
      "type": "string",
      "minLength": 1
    },
    "emitter_id": {
      "type": "string",
      "minLength": 1
    },
    "session_kind": {
      "type": "string",
      "enum": [
        "local_persistent",
        "remote_ephemeral",
        "ci"
      ]
    },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "span_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "trace_id",
        "span_id",
        "parent_span_id",
        "links"
      ]
    },
    "time": {
      "type": "object",
      "properties": {
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "ingested_at": {
          "type": "null"
        }
      },
      "required": [
        "occurred_at",
        "observed_at",
        "ingested_at"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "agent",
            "tool",
            "ci",
            "eos"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "sequence"
      ]
    },
    "revision": {
      "type": "object",
      "properties": {
        "repo_sha": {
          "type": "string",
          "minLength": 1
        },
        "eos_release": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repo_sha",
        "eos_release"
      ]
    },
    "harness": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "available_capabilities_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "agent",
        "model",
        "adapter_version",
        "available_capabilities_hash"
      ]
    },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "stability",
    "introduced_in",
    "event_id",
    "event_type",
    "project_id",
    "work_id",
    "run_id",
    "installation_id",
    "emitter_id",
    "session_kind",
    "trace",
    "time",
    "source",
    "revision",
    "harness",
    "attributes"
  ],
  "additionalProperties": false
}
