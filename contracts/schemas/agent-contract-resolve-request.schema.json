{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "task_hint": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 50
    },
    "include_controls": {
      "type": "boolean"
    },
    "ranking_mode": {
      "type": "string",
      "enum": [
        "live_overlay",
        "recorded"
      ]
    },
    "score_view_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "task_hint",
    "project_id",
    "run_id"
  ],
  "additionalProperties": false
}
