{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "type": "string",
      "enum": [
        "development",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "introduced_in": {
      "type": "string",
      "minLength": 1
    },
    "deprecated_in": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "migration_path": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_score_view_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "live_overlay",
        "recorded"
      ]
    },
    "parent_score_view_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "scoring_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_watermark": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "computed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "effective_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "string",
            "enum": [
              "overlay",
              "snapshot"
            ]
          }
        },
        "required": [
          "id",
          "effective_score",
          "evidence_count",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "challenge_states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "solution_set_id": {
            "type": "string",
            "minLength": 1
          },
          "challenge_state": {
            "type": "string",
            "enum": [
              "none",
              "challenged"
            ]
          },
          "challenger_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "margin": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "solution_set_id",
          "challenge_state",
          "challenger_asset_id",
          "margin"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "stability",
    "introduced_in",
    "effective_score_view_id",
    "mode",
    "parent_score_view_id",
    "scoring_policy_version",
    "evidence_watermark",
    "computed_at",
    "assets",
    "challenge_states"
  ],
  "additionalProperties": false
}
