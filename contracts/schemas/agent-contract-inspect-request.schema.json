{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "handle": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "asset",
            "snapshot",
            "solution_set"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "handle",
    "run_id"
  ],
  "additionalProperties": false
}
