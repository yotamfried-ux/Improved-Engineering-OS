{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "type": "string",
      "enum": [
        "development",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "introduced_in": {
      "type": "string",
      "minLength": 1
    },
    "deprecated_in": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "migration_path": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proven",
        "failed",
        "unproven"
      ]
    },
    "unproven_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "not_executed",
            "not_observed",
            "no_subject",
            "blocked"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "observed_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "stability",
    "introduced_in",
    "id",
    "statement",
    "status",
    "unproven_reason",
    "evidence",
    "observed_on",
    "required_on"
  ],
  "additionalProperties": false
}
