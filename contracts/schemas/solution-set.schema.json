{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "type": "string",
      "enum": [
        "development",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "introduced_in": {
      "type": "string",
      "minLength": 1
    },
    "deprecated_in": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "migration_path": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "compatibility_key": {
      "type": "string",
      "minLength": 1
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "canonical_state": {
      "type": "string",
      "enum": [
        "unresolved",
        "pinned"
      ]
    },
    "champion_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "champion_since_release": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "why_unresolved": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "stability",
    "introduced_in",
    "id",
    "problem_id",
    "compatibility_key",
    "members",
    "canonical_state",
    "champion_id",
    "champion_since_release",
    "why_unresolved"
  ],
  "additionalProperties": false
}
