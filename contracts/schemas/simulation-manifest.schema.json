{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "type": "string",
      "enum": [
        "development",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "introduced_in": {
      "type": "string",
      "minLength": 1
    },
    "deprecated_in": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "migration_path": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "properties": {
        "repo_revision": {
          "type": "string",
          "minLength": 1
        },
        "eos_release": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "network_policy": {
          "type": "string",
          "enum": [
            "deny",
            "allowlist",
            "unrestricted"
          ]
        },
        "budgets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": [
        "repo_revision",
        "eos_release",
        "agent",
        "model",
        "tools",
        "permissions",
        "network_policy",
        "budgets"
      ],
      "additionalProperties": false
    },
    "starting_state": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "stimulus": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task"
      ],
      "additionalProperties": false
    },
    "hidden_conditions_ref": {
      "type": "string",
      "pattern": "^evaluator-only:\\/\\/.+"
    },
    "allowed_interventions": {
      "type": "object",
      "properties": {
        "user_architecture_decision": {
          "type": "boolean"
        },
        "eos_coaching": {
          "type": "boolean"
        }
      },
      "required": [
        "user_architecture_decision",
        "eos_coaching"
      ],
      "additionalProperties": false
    },
    "success_criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_criteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "graders": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "deterministic",
              "trace_rule",
              "model"
            ]
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "validity_controls": {
      "type": "object",
      "properties": {
        "positive": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "negative": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mutation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "positive",
        "negative",
        "mutation"
      ],
      "additionalProperties": false
    },
    "required_evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "procedure": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "procedure"
      ],
      "additionalProperties": false
    },
    "repetition_policy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "deterministic",
            "stochastic"
          ]
        },
        "minimum_trials": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "stopping_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "minimum_trials",
        "stopping_rule"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "stability",
    "introduced_in",
    "id",
    "version",
    "claim",
    "environment",
    "starting_state",
    "stimulus",
    "hidden_conditions_ref",
    "allowed_interventions",
    "success_criteria",
    "failure_criteria",
    "stop_conditions",
    "graders",
    "validity_controls",
    "required_evidence",
    "recovery",
    "repetition_policy"
  ],
  "additionalProperties": false
}
