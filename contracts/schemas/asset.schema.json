{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "type": "string",
      "enum": [
        "development",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "introduced_in": {
      "type": "string",
      "minLength": 1
    },
    "deprecated_in": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "migration_path": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "pattern",
        "skill",
        "template",
        "reference_test",
        "reference_repo",
        "lesson",
        "failed_solution",
        "provider",
        "integration",
        "fact",
        "control_guidance"
      ]
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "restricted",
        "quarantined",
        "deprecated",
        "superseded"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "legacy_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "problem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "capabilities"
      ]
    },
    "solution_set_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "applicability": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fact": {
                "type": "string",
                "minLength": 1
              },
              "in": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "fact",
              "in"
            ]
          }
        }
      },
      "required": [
        "conditions"
      ]
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "platforms",
        "providers",
        "constraints"
      ]
    },
    "provenance": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "official_docs",
              "repo",
              "existing_eos",
              "observation",
              "external_attestation",
              "owner"
            ]
          },
          "source_identity": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "integrity": {
            "type": "string",
            "enum": [
              "verified",
              "partial",
              "unknown"
            ]
          }
        },
        "required": [
          "source_type",
          "source_identity",
          "source_revision",
          "observed_at",
          "integrity"
        ]
      }
    },
    "freshness": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "stable",
            "normal",
            "volatile",
            "live_required"
          ]
        },
        "last_verified_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "class",
        "last_verified_at"
      ]
    },
    "risk": {
      "type": "object",
      "properties": {
        "execution_authority": {
          "type": "string",
          "enum": [
            "data_only",
            "executable"
          ]
        },
        "blast_radius": {
          "type": "string",
          "enum": [
            "read_only",
            "write",
            "destructive",
            "privileged"
          ]
        }
      },
      "required": [
        "execution_authority",
        "blast_radius"
      ]
    },
    "relationships": {
      "type": "object",
      "properties": {
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "related_to": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "supersedes",
        "superseded_by",
        "related_to"
      ]
    },
    "evidence_policy": {
      "type": "object",
      "properties": {
        "eligible_origins": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "development",
              "qualification",
              "operational",
              "external_attestation"
            ]
          }
        }
      },
      "required": [
        "eligible_origins"
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "stability",
    "introduced_in",
    "id",
    "type",
    "slug",
    "title",
    "summary",
    "status",
    "content_hash",
    "legacy_ids",
    "problem",
    "solution_set_id",
    "applicability",
    "compatibility",
    "provenance",
    "freshness",
    "risk",
    "relationships",
    "evidence_policy",
    "body",
    "files"
  ],
  "additionalProperties": false
}
