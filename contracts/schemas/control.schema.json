{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "type": "string",
      "enum": [
        "development",
        "stable",
        "deprecated",
        "removed"
      ]
    },
    "introduced_in": {
      "type": "string",
      "minLength": 1
    },
    "deprecated_in": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "replacement": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "migration_path": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "critical": {
      "type": "boolean"
    },
    "applies_when": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "eq": {
            "type": [
              "string",
              "boolean",
              "number"
            ]
          },
          "in": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "fact"
        ],
        "additionalProperties": false
      }
    },
    "satisfied_by": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_kind": {
            "type": "string",
            "minLength": 1
          },
          "subject_type": {
            "type": "string",
            "minLength": 1
          },
          "min_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "evidence_kind",
          "subject_type",
          "min_confidence"
        ],
        "additionalProperties": false
      }
    },
    "default_scope": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_age_days": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "paths",
        "depends_on",
        "max_age_days"
      ],
      "additionalProperties": false
    },
    "exemption": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "max_days": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "requires_decision": {
          "type": "boolean"
        }
      },
      "required": [
        "allowed",
        "max_days",
        "requires_decision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "stability",
    "introduced_in",
    "id",
    "title",
    "critical",
    "applies_when",
    "satisfied_by",
    "default_scope",
    "exemption"
  ],
  "additionalProperties": false
}
